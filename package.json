{
  "name": "logtap",
  "version": "1.0.3",
  "description": "A lightweight, secure HTTP logging server with NeDB, MongoDB, and MSSQL persistence",
  "main": "src/index.js",
  "type": "module",
  "bin": {
    "logtap": "./src/index.js"
  },
  "scripts": {
    "start": "node src/index.js start",
    "dev": "node src/index.js start --verbose",
    "embed-assets": "node scripts/embed-assets.js",
    "prebuild": "npm run embed-assets",
    "build": "node scripts/build.mjs",
    "build:windows": "node scripts/build.mjs windows",
    "build:linux": "node scripts/build.mjs linux",
    "build:mac": "node scripts/build.mjs mac",
    "build:esbuild": "esbuild src/index.js --bundle --platform=node --format=cjs --outfile=dist/logtap.cjs",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/unit",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/integration"
  },
  "keywords": [
    "logging",
    "http",
    "mongodb",
    "mssql",
    "nedb",
    "cli",
    "server"
  ],
  "author": "https://github.com/antoine-marchal/LogTap",
  "license": "MIT",
  "dependencies": {
    "commander": "^12.1.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "mongodb": "^6.9.0",
    "mssql": "^11.0.1",
    "nedb-promises": "^6.2.3"
  },
  "devDependencies": {
    "esbuild": "^0.27.2",
    "jest": "^29.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
